# --- Reddit (empfohlen; ohne Zugangsdaten wird die öffentliche JSON-API versucht) ---
# App anlegen: https://www.reddit.com/prefs/apps  ->  Typ "script"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=reddit-story-bot/1.0 (by u/DEIN_REDDIT_NAME)

# --- YouTube (Upload) ---
# Mit scripts/youtube_auth.py erzeugen
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- TikTok (Upload) ---
# Client Key/Secret aus developers.tiktok.com, Refresh-Token mit scripts/tiktok_auth.py erzeugen
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=

# --- Optional: Hintergrundclips aus dem Netz laden (eine URL pro Zeile oder komma-getrennt) ---
# Praktisch für GitHub Actions, damit keine großen Videos im Repo liegen müssen.
BACKGROUND_URLS=
